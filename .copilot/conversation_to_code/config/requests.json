{
  "getAgents": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/agents",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      },
      "query": {
        "page": "<%= context.page %>",
        "per_page": "100"
      }
    },
    "options": {
      "retryDelay": 1000
    }
  },
  "getAgentsListForSettings": {
    "schema": {
      "method": "GET",
      "host": "<%= context.domain %>",
      "path": "/api/v2/agents",
      "headers": {
        "Authorization": "Basic <%= encode(context.api_key) %>",
        "Content-Type": "application/json"
      },
      "query": {
        "page": "<%= context.page %>",
        "per_page": "100"
      }
    },
    "options": {
      "retryDelay": 1000
    }
  },
  "validateFd": {
    "schema": {
      "method": "GET",
      "host": "<%= context.domain %>",
      "path": "/api/v2/tickets",
      "headers": {
        "Authorization": "Basic <%= encode(context.api_key) %>",
        "Content-Type": "application/json"
      }
    },
    "options": {
      "retryDelay": 1000
    }
  },
  "getStatusList": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/ticket_fields?type=default_status",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getGroupList": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/ticket_fields?type=default_group",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getAllTickets": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/tickets",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.credentials[context.agentId]) %>",
        "Content-Type": "application/json"
      },
      "query": {
        "page": "<%= context.page %>",
        "per_page": "100"
      }
    }
  },
  "getAgent": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/agents/<%= context.agentId %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getTicketFields": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/ticket_fields",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "updateTicket": {
    "schema": {
      "method": "PUT",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/tickets/<%= context.ticketId %>",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  },
  "getTicketDetails": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.domain %>",
      "path": "/api/v2/tickets/<%= context.ticketId %>?include=conversations",
      "headers": {
        "Authorization": "Basic <%= encode(iparam.api_key) %>",
        "Content-Type": "application/json"
      }
    }
  }
}
